# Clerk — provision via `vercel integration add clerk` (or the Clerk dashboard).
# Google OAuth only for Live Abundantly University (disable email/password in Clerk).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
