NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/university
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/university
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/university
